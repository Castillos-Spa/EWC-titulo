generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                  @id @default(autoincrement())
  username             String
  email                String               @unique
  password             String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  assignedTickets      Ticket[]             @relation("AssignedTickets")
  createdTickets       Ticket[]             @relation("CreatedTickets")
  active               Boolean              @default(true)
  lastLogin            DateTime?
  fuelLogs             FuelLog[]            @relation("FuelLogs")
  mustChangePassword   Boolean              @default(false)
  refreshToken         String?              @unique
  notifications        Notification[]
  createdNotifications Notification[]       @relation("CreatedNotifications")
  roleAssignments      UserRoleAssignment[]
  TicketApproval       TicketApproval[]
}

model UserRoleAssignment {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        String // 'IT', 'Transporte', 'Obras', 'Aseo', 'RRHH', 'Finanza', 'P_Riesgo'
  role        Role // Roles jerárquicos
  specialty   Specialty? // Solo para especialistas
  permissions Permission[] @default([])
  isActive    Boolean      @default(true)
  assignedAt  DateTime     @default(now())

  @@unique([userId, area, role]) // Un usuario no puede tener el mismo rol dos veces en la misma área
  @@index([userId])
  @@index([area, role])
}

model Ticket {
  id                         Int              @id @default(autoincrement())
  title                      String
  description                String?
  status                     TicketStatus     @default(Pendiente)
  priority                   TicketPriority   @default(Media)
  category                   TicketCategory
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  createdById                Int
  assignedToId               Int?
  assignedTo                 User?            @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdBy                  User             @relation("CreatedTickets", fields: [createdById], references: [id])
  recipientArea              String[]         @default([])
  recipientRole              Role[]
  assignedUserConfirmation   Boolean?         @default(false)
  requestingUserConfirmation Boolean?         @default(false)
  tags                       String[]         @default([])
  attachments                Documento[]
  ordenTrabajoId             Int?             @unique // Un ticket de revisión es único para una OT
  ordenTrabajo               OrdenTrabajo?    @relation("OTReviewTicket", fields: [ordenTrabajoId], references: [id])
  approvals                  TicketApproval[]
}

model Vehiculo {
  id                  Int            @id @default(autoincrement())
  patente             String         @unique
  marca               String         @default("")
  modelo              String         @default("")
  capacidad           Float
  odometro            Int
  estado              VehiculoStatus @default(disponible)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  documentos          Documento[] // Relación con la tabla Documento
  ordenes             OrdenTrabajo[]
  areaAsignada        String?
  conductorId         Int?
  fuelLogs            FuelLog[]
  lastMaintenanceDate DateTime?
}

model Documento {
  id          Int      @id @default(autoincrement())
  vehiculoId  Int
  vehiculo    Vehiculo @relation(fields: [vehiculoId], references: [id])
  tipo        String // Ej: "factura", "certificado", "foto"
  url         String // URL o path del archivo subido (ej: S3, local storage)
  fechaSubida DateTime @default(now())
  descripcion String?
  ticketId    Int?
  ticket      Ticket?  @relation(fields: [ticketId], references: [id])
}

model OrdenTrabajo {
  id              Int       @id @default(autoincrement())
  tipo            String // Preventivo, Correctivo, Emergencia
  estado          String    @default("abierta")
  vehiculo        Vehiculo  @relation(fields: [vehiculoId], references: [id])
  vehiculoId      Int
  description     String?
  scheduledDate   DateTime?
  estimatedCost   Float?
  observations    String?
  responsableId   Int?
  // responsable   User?    @relation("OTResponsable", fields: [responsableId], references: [id]) // Opcional si quieres la relación completa
  nextServiceDate DateTime?
  reviewTicket    Ticket?   @relation("OTReviewTicket")
  repuestos       String[]  @default([])
  tareas          String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  qa              QA[]
}

model QA {
  id        Int          @id @default(autoincrement())
  checklist String
  resultado String
  ot        OrdenTrabajo @relation(fields: [otId], references: [id])
  otId      Int
  createdAt DateTime     @default(now())
}

model SolicitudCompra {
  id        Int        @id @default(autoincrement())
  monto     Float
  aprobada  Boolean    @default(false)
  createdAt DateTime   @default(now())
  repuestos Repuesto[]
}

model Repuesto {
  id                Int              @id @default(autoincrement())
  nombre            String
  stock             Int              @default(0)
  costoUnitario     Float            @default(0)
  solicitudCompra   SolicitudCompra? @relation(fields: [solicitudCompraId], references: [id])
  solicitudCompraId Int?
  createdAt         DateTime         @default(now())
}

model Notification {
  id          Int      @id @default(autoincrement())
  title       String
  message     String
  type        String // Ej: "info", "warning", "ticket"
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
  user        User[]
  areas       String[] @default([])
  roles       Role[]   @default([])
  createdById Int
  createdBy   User     @relation("CreatedNotifications", fields: [createdById], references: [id])
}

model TicketApproval {
  id           Int            @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  step         Int // Orden en la cadena de aprobación (1, 2, 3...)
  status       ApprovalStatus @default(Pendiente)
  approverRole Role
  approverArea String
  approvedById Int?
  approvedBy   User?          @relation(fields: [approvedById], references: [id])
  approvedAt   DateTime?
  comments     String?

  @@unique([ticketId, step])
  @@index([ticketId])
  @@index([approverArea, approverRole])
}

model FuelLog {
  id         Int      @id @default(autoincrement())
  vehiculoId Int
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  date       DateTime
  liters     Float
  cost       Float?
  odometer   Int
  driverId   Int
  driver     User     @relation("FuelLogs", fields: [driverId], references: [id])
  invoiceUrl String?
  createdAt  DateTime @default(now())

  @@index([vehiculoId, date])
}

//=================================================================>ENUMS<==================================================================

/// Enum de roles
enum Role {
  Admin
  Jefe
  Supervisor
  Especialista
  Trabajador
  Lector
}

/// Enum de especialidades
enum Specialty {
  // Transporte
  DRIVER
  MECHANIC
}

/// Enum de permisos
enum Permission {
  // Permisos generales - ALL users y IT
  VIEW_DASHBOARD
  VIEW_TICKETS
  MANAGE_TICKETS

  // Transporte - Supervisor
  MANAGE_ROUTES
  MANAGE_FLEET

  // Transporte - Supervisor y Driver
  VIEW_TRIP_REPORTS
  MANAGE_TRIP_REPORTS // Driver crea solamente reportes
  VIEW_ROUTES

  // Transporte - Supervisor y Mecánico
  VIEW_FLEET
  VIEW_MAINTENANCE
  MANAGE_MAINTENANCE

  // Obras
  VIEW_CIVIL_WORKS
  MANAGE_CIVIL_WORKS

  // Aseo
  VIEW_CLEANING_REPORTS
  MANAGE_CLEANING_REPORTS

  // Admin
  VIEW_MANAGEMENT_USER
  MANAGE_MANAGEMENT_USER

  // RRHH
  VIEW_EMPLOYEES
  MANAGE_EMPLOYEES
  VIEW_PAYROLL
  MANAGE_PAYROLL

  // Finanzas
  VIEW_FINANCIAL_REPORTS
  MANAGE_BUDGETS
  APPROVE_EXPENSES

  // P_Riesgo
  VIEW_RISK_ASSESSMENTS
  MANAGE_RISK_ASSESSMENTS
  CREATE_SAFETY_PROTOCOLS
}

enum TicketStatus {
  Pendiente
  EnProgreso
  Resuelto
  Cerrado
}

enum TicketPriority {
  Baja
  Media
  Alta
  Urgente
}

enum VehiculoStatus {
  disponible
  en_mantenimiento
  inactivo
  en_uso
}

enum TicketCategory {
  Soporte_IT
  Solicitud_Suministro
  Mantenimiento
  Reporte_Incidente
}

enum ApprovalStatus {
  Pendiente
  Aprobado
  Rechazado
}
