// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  username    String
  email       String   @unique
  area        String
  password    String
  roles       Role[]   @default([])
  permissions Permission[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones con los tickets
  assignedTickets Ticket[] @relation("AssignedTickets")
  createdTickets  Ticket[] @relation("CreatedTickets")
}

// Modelo de tickets
model Ticket {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      TicketStatus   @default(Pendiente)
  priority    TicketPriority @default(Media)
  category    String // e.g., Soporte IT, Mantenimiento, Suministros

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relación con el usuario que lo creó
  createdBy   User @relation("CreatedTickets", fields: [createdById], references: [id])
  createdById Int

  // Relación con el usuario asignado (opcional)
  assignedTo   User? @relation("AssignedTickets", fields: [assignedToId], references: [id])
  assignedToId Int?
}

enum TicketStatus {
  Pendiente
  EnProgreso
  Resuelto
  Cerrado
}

enum TicketPriority {
  Baja
  Media
  Alta
  Urgente
}


/// Enum de roles
enum Role {
  Admin
  Transporte
  Driver
  Obras
  Aseo
  IT
  User
}

/// Enum de permisos
enum Permission {
  // General
  VIEW_DASHBOARD
  VIEW_TICKETS
  MANAGE_TICKETS

  // Transporte
  VIEW_TRIP_REPORTS
  MANAGE_TRIP_REPORTS
  VIEW_ROUTES
  MANAGE_ROUTES
  VIEW_FLEET
  MANAGE_FLEET
  VIEW_MAINTENANCE
  MANAGE_MAINTENANCE

  // Obras
  VIEW_CIVIL_WORKS
  MANAGE_CIVIL_WORKS

  // Aseo
  VIEW_CLEANING_REPORTS
  MANAGE_CLEANING_REPORTS
}