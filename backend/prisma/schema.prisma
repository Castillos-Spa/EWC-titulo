generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
model User {
  id              Int          @id @default(autoincrement())
  username        String
  email           String       @unique
  area            String
  password        String
  roles           Role[]       @default([])
  permissions     Permission[] @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  assignedTickets Ticket[]     @relation("AssignedTickets")
  createdTickets  Ticket[]     @relation("CreatedTickets")
}

model Ticket {
  id           Int            @id @default(autoincrement())
  title        String
  description  String?
  status       TicketStatus   @default(Pendiente)
  priority     TicketPriority @default(Media)
  category     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  Int
  assignedToId Int?
  assignedTo   User?          @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdBy    User           @relation("CreatedTickets", fields: [createdById], references: [id])
}

model Vehiculo {
  id         Int            @id @default(autoincrement())
  patente    String
  capacidad  Float
  odometro   Int
  estado     VehiculoStatus @default(disponible)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  documentos Documento[] // Relación con la tabla Documento
  ordenes    OrdenTrabajo[]
}

model Documento {
  id          Int      @id @default(autoincrement())
  vehiculoId  Int
  vehiculo    Vehiculo @relation(fields: [vehiculoId], references: [id])
  tipo        String // Ej: "factura", "certificado", "foto"
  url         String // URL o path del archivo subido (ej: S3, local storage)
  fechaSubida DateTime @default(now())
  descripcion String?
}

model OrdenTrabajo {
  id         Int      @id @default(autoincrement())
  tipo       String
  estado     String   @default("abierta")
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])
  vehiculoId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  qa         QA[]
}

model QA {
  id        Int          @id @default(autoincrement())
  checklist String
  resultado String
  ot        OrdenTrabajo @relation(fields: [otId], references: [id])
  otId      Int
  createdAt DateTime     @default(now())
}

model SolicitudCompra {
  id        Int        @id @default(autoincrement())
  monto     Float
  createdAt DateTime   @default(now())
  repuestos Repuesto[]
}

model Repuesto {
  id                Int              @id @default(autoincrement())
  nombre            String
  stock             Int              @default(0)
  costoUnitario     Float
  solicitudCompra   SolicitudCompra? @relation(fields: [solicitudCompraId], references: [id])
  solicitudCompraId Int?
  createdAt         DateTime         @default(now())
}

enum TicketStatus {
  Pendiente
  EnProgreso
  Resuelto
  Cerrado
}

enum TicketPriority {
  Baja
  Media
  Alta
  Urgente

}

enum TicketStatus {
  Pendiente
  EnProgreso
  Resuelto
  Cerrado
}

/// Enum de roles
enum Role {
  Admin
  Transporte
  Driver
  Obras
  Aseo
  IT
  User
}

/// Enum de permisos
enum Permission {
  VIEW_DASHBOARD
  VIEW_TICKETS
  MANAGE_TICKETS
  VIEW_TRIP_REPORTS
  MANAGE_TRIP_REPORTS
  VIEW_ROUTES
  MANAGE_ROUTES
  VIEW_FLEET
  MANAGE_FLEET
  VIEW_MAINTENANCE
  MANAGE_MAINTENANCE
  VIEW_CIVIL_WORKS
  MANAGE_CIVIL_WORKS
  VIEW_CLEANING_REPORTS
  MANAGE_CLEANING_REPORTS
}
