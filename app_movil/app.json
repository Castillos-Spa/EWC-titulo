{
  "expo": {
    "name": "POGI_EWC",
    "slug": "POGI_EWC",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "expo-sqlite"
    ],
    "extra": {
      "apiUrl": "http://localhost:3000",
      "router": {},
      "eas": {
        "projectId": "a27ff41d-1b59-4336-90b6-d7bc04c99048"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.POGI_EWC"
    }
  }
}
