# URL base del backend (incluye el prefijo global "api/v1")
# Ajusta esto en tu entorno local o de despliegue
# Ejemplo local por defecto de NestJS con prefix configurado en main.ts:
VITE_API_URL=http://localhost:3000/api/v1

# Activa el modo demo en el frontend web (sin tocar el backend).
# true: las llamadas se responden con datos locales simulados a nivel frontend (solo web).
# false: se usa el backend real apuntado por VITE_API_URL.
VITE_DEMO_MODE=false

# (Opcional) Si dispones de un backend demo aparte, puedes setear su URL aquí.
# Si VITE_DEMO_MODE=true y VITE_DEMO_API_URL está definido, se utilizará este backend demo
# en lugar de los datos locales simulados.
# VITE_DEMO_API_URL=https://demo.tu-backend.com/api/v1
